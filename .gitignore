# ==============================================================================
# DocuMind AI — Root .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.env.local
*.env.*.local
*.local.json
appsettings.*.local.json

# Dependencies & Build Artifacts
node_modules/
bin/
obj/
dist/
dist-ssr/
build/
publish/
[Aa]pp[Dd]ata/
App_Data/

# IDE & Editor files
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.sw?

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & Coverage Artifacts
TestResults/
[Tt]est[Rr]esults/
*.trx
coverage/
