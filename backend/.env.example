# ==============================================================================
# DocuMind Backend Environment Configuration (Placeholders Only)
# Copy this file to .env and replace placeholders with your local/cloud secrets.
# Never commit real credentials to source control.
# ==============================================================================

# MySQL Database Configuration
# Host port 3308 avoids collision with any local Windows MySQL service running on 3306
MYSQL_PORT=3308
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=documind_db
MYSQL_USER=documind_user
MYSQL_PASSWORD=CHANGE_ME

# Qdrant Vector Database
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Azure OpenAI / Foundry Configuration (Placeholders)
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Text Chunking Settings
CHUNKING_TARGET_SIZE=1000
CHUNKING_OVERLAP_SIZE=200
CHUNKING_MIN_SIZE=50

# Enterprise Authentication & Security (Phase 7B)
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_SECRET_KEY!
JWT_ISSUER=DocuMind.WebApi
JWT_AUDIENCE=DocuMind.Client

